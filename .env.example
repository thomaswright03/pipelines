# Copy to .env for local development. The app checks what it needs at
# startup (src/instrumentation.ts) and refuses to start with an error naming
# anything missing. The values below are the SAFE LOCAL DEFAULTS: a local
# Postgres and email captured to files — nothing is ever delivered.
# Production values live only in Vercel's environment settings.

# --- Database -------------------------------------------------------------

# Used by the running app (src/lib/db.ts). Required.
# Local: a Postgres on this machine (see README "Running it locally").
# Production: Neon's *pooled* connection string (…-pooler….neon.tech).
PIPELINES_DATABASE_URL="postgresql://ci:ci@localhost:5432/pipelines_dev"

# Used only by Prisma Migrate / Studio (prisma.config.ts), never by the app.
# Production: Neon's *unpooled* connection string.
PIPELINES_DIRECT_URL="postgresql://ci:ci@localhost:5432/pipelines_dev"

# Optional: "neon" or "pg". By default *.neon.tech hosts use Neon's
# WebSocket driver and everything else the standard pg driver.
# PIPELINES_DB_DRIVER=""

# Test suite only (npm test): a disposable database that the tests empty
# before every test. Must be on localhost. Default shown.
# TEST_DATABASE_URL="postgresql://ci:ci@localhost:5432/pipelines_test"

# --- Email ----------------------------------------------------------------

# Where outreach email goes (src/lib/send-email.ts):
#   outbox    — written as .eml files to OUTBOX_DIR; nothing is sent.
#               The default everywhere except Vercel.
#   smtp      — to SMTP_HOST:SMTP_PORT, meant for a local mail catcher such
#               as Mailpit (http://localhost:8025 shows what was "sent").
#   zeptomail — real delivery through ZeptoMail. The default on Vercel.
#               Never set this locally.
EMAIL_TRANSPORT="outbox"
OUTBOX_DIR=".outbox"
# SMTP_HOST="127.0.0.1"
# SMTP_PORT="1025"
# SMTP_USER=""
# SMTP_PASSWORD=""

# Production only (EMAIL_TRANSPORT=zeptomail): the ZeptoMail SMTP password
# from the sending domain's Mail Agent > Setup > SMTP page. The username is
# always the literal "emailapikey".
# ZEPTOMAIL_SMTP_USER="emailapikey"
# ZEPTOMAIL_SMTP_PASSWORD=""

# Optional sender overrides; both default to thomas@wright-ai-solutions.com.
# DATALEADSELL_SENDER_EMAIL=""
# VAULT_PIPELINE_SENDER_EMAIL=""

# Emergency stop for ALL outbound email (src/lib/outbound-switch.ts). Any
# value but empty/0/false/no/off stops every send path (a single send, bulk
# sends, the daily run) like the Settings pause, and works when the app or
# its database can't be reached. On Vercel: Project → Settings →
# Environment Variables → add OUTBOUND_EMAIL_DISABLED=1 for Production →
# Redeploy; it applies once the redeploy is Ready (usually 1-3 minutes) —
# see docs/deployment.md → "Emergency stop". Remove it and redeploy to send
# again.
# OUTBOUND_EMAIL_DISABLED=""

# --- Integrations (required on Vercel, optional locally) -------------------

# Yelp Fusion API key for business discovery (src/lib/yelp-discovery.ts).
# Locally, leave it empty unless you mean to spend real Yelp calls: the
# search buttons then say the key is missing.
YELP_API_KEY=""

# Bearer token the inbound-email worker sends to /api/email-inbound
# (see docs/deployment.md "Reply tracking"). Any long random string, e.g.
# `openssl rand -hex 32`; the worker must send the same value.
EMAIL_INBOUND_SECRET=""

# Bearer token Vercel Cron sends to /api/cron/* (Vercel adds it
# automatically when CRON_SECRET is set on the project).
CRON_SECRET=""

# --- Display --------------------------------------------------------------

# Time zone for every date shown and for "today" in the stats.
# Default America/Phoenix (Arizona, no daylight saving time).
# NEXT_PUBLIC_APP_TIME_ZONE="America/Phoenix"
