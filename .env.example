# Copy this file to .env and fill in real values. The app validates these
# at startup (see src/instrumentation.ts) and refuses to start with a clear
# error naming whatever's missing.

# Neon Postgres — pooled connection string, used by the running app at
# runtime (src/lib/db.ts). Required.
PIPELINES_DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon Postgres — unpooled connection string, used only by Prisma
# Migrate/CLI (prisma.config.ts), never by the running app. Required to run
# migrations; not required just to run the app.
PIPELINES_DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# ZeptoMail SMTP relay — sends all outreach email for every pipeline (see
# src/lib/send-email.ts). Username is always the literal string
# "emailapikey" per Zoho's convention; only the password varies per
# account. Get it from the sending domain's Mail Agent > Setup > SMTP page
# in ZeptoMail, after the domain is verified there. Required.
ZEPTOMAIL_SMTP_USER="emailapikey"
ZEPTOMAIL_SMTP_PASSWORD=""

# Yelp Fusion/Places API key — business discovery for every pipeline (see
# src/lib/yelp-discovery.ts). Get one free at
# https://www.yelp.com/developers/v3/manage_app. Required.
YELP_API_KEY=""

# Shared secret the Cloudflare Email Worker sends as a Bearer token when it
# POSTs an inbound reply to /api/email-inbound — must match the same value
# set on the deployed Worker (`wrangler secret put PIPELINES_INBOUND_SECRET`
# in cloudflare-email-worker/). Required.
EMAIL_INBOUND_SECRET=""

# Bearer token Vercel Cron (and any manual curl test) must send to
# /api/cron/* routes. Generate any random string, e.g. `openssl rand -hex
# 32`. Required.
CRON_SECRET=""

# Optional overrides — both default to thomas@wright-ai-solutions.com if
# unset. Only set these if a pipeline should send from a different address.
DATALEADSELL_SENDER_EMAIL=""
VAULT_PIPELINE_SENDER_EMAIL=""
